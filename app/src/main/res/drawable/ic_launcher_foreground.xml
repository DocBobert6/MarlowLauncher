        android:pathData="M37.1,32.1H48.9Q52.7,32.1 52.7,35.9V47.7Q52.7,51.5 48.9,51.5H37.1Q33.3,51.5 33.3,47.7V35.9Q33.3,32.1 37.1,32.1Z" />
